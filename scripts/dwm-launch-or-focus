#!/bin/bash

# Launch or focus on a given command identified by the passed in window-pattern.

if (($# == 0)); then
  echo "Usage: dwm-launch-or-focus [window-pattern] [launch-command]"
  exit 1
fi

WINDOW_PATTERN="$1"
LAUNCH_COMMAND="${2:-"$WINDOW_PATTERN"}"
shift

# Find an existing window by class or title and ask dwm to focus it.
# Normal activation requests (_NET_ACTIVE_WINDOW) are ignored by dwm (vanilla
# urgency-only behaviour), so use the private _DWM_FOCUS_WINDOW channel instead.
if command -v wmctrl &>/dev/null && command -v xprop &>/dev/null; then
  winid=$(wmctrl -lx 2>/dev/null | awk -v pat="$WINDOW_PATTERN" '
    BEGIN { p = tolower(pat) }
    {
      cls = tolower($3)
      line = tolower($0)
      if (!byclass && index(cls, p)) byclass = $1
      if (!byname && index(line, p)) byname = $1
    }
    END { if (byclass) print byclass; else if (byname) print byname }')
  if [[ -n "$winid" ]]; then
    xprop -root -f _DWM_FOCUS_WINDOW 32c \
      -set _DWM_FOCUS_WINDOW "$winid" >/dev/null 2>&1
    exit 0
  fi
fi

# Fallback: launch new instance
eval exec setsid $LAUNCH_COMMAND
